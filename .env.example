# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID, которым разрешён доступ к боту (через запятую). Свой ID бот покажет на /start.
ALLOWED_USERS=

# Куда присылать лиды каждый день: ID группы с командой (начинается с -100…) или ID одного человека.
# ID группы: добавь бота в группу и напиши там /id. Пусто — первому из ALLOWED_USERS.
LEADS_CHAT_ID=

# Токен Apify (бесплатный план, без карты): console.apify.com → Settings → API & Integrations → Personal API token
APIFY_TOKEN=

# Расход бесплатных $5 Apify: сколько компаний с Google Maps брать в день, сколько на один запрос
# и при какой сумме за месяц ($) остановиться. 35 в день по будням ≈ 770 компаний ≈ $4 в месяц.
APIFY_PLACES_PER_DAY=35
APIFY_PLACES_PER_QUERY=10
APIFY_MONTHLY_BUDGET=4.5
# Проверять Instagram через Apify, когда Instagram блокирует прямые запросы (тратит тот же бюджет)
APIFY_INSTAGRAM=false

# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модели по порядку: если первая недоступна, берётся следующая
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Максимум лидов за запуск, во сколько (по Еревану) и в какие дни (1 = понедельник). DAILY_TIME пустой — только по /leads
DAILY_LEADS=10
DAILY_TIME=10:00
DAILY_WEEKDAYS=1,2,3,4,5
TIMEZONE=Asia/Yerevan

# Фильтры «новый и активный бизнес»:
# последний пост в Instagram не старше ACTIVE_DAYS дней,
# постов не больше MAX_POSTS, отзывов в Google не больше MAX_REVIEWS
ACTIVE_DAYS=30
MAX_POSTS=400
MAX_REVIEWS=200
# Минимальная оценка ИИ (1–10), чтобы лид попал в Telegram
MIN_SCORE=6
