# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID, которым разрешён доступ к боту (через запятую). Свой ID бот покажет на /start.
ALLOWED_USERS=

# Куда присылать лиды каждый день: ID группы с командой (начинается с -100…) или ID одного человека.
# ID группы: добавь бота в группу и напиши там /id. Пусто — первому из ALLOWED_USERS.
LEADS_CHAT_ID=

# Токен Apify (бесплатный план, без карты): console.apify.com → Settings → API & Integrations → Personal API token
APIFY_TOKEN=

# Расход бесплатных $5 Apify: сколько компаний с Google Maps брать в день, сколько на один запрос
# и при какой сумме за месяц ($) остановиться. 40 в день по будням ≈ 880 компаний ≈ $4.4 в месяц.
APIFY_PLACES_PER_DAY=40
APIFY_PLACES_PER_QUERY=5
APIFY_MONTHLY_BUDGET=4.5
# Проверять Instagram через Apify, когда Instagram блокирует прямые запросы (тратит тот же бюджет)
APIFY_INSTAGRAM=false

# Необязательно, но рекомендуется: Meta Instagram Graph API (Business Discovery) — надёжно читает
# бизнес-профили Instagram (подписчики, био, последние посты), Instagram его не блокирует. Как получить — README.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_API_VERSION=v23.0

# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модели по порядку: если первая недоступна, берётся следующая
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Максимум карточек за запуск (каждая купленная компания = карточка), во сколько (по Еревану) и в какие дни (1 = понедельник). DAILY_TIME пустой — только по /leads
DAILY_LEADS=40
DAILY_TIME=10:00
DAILY_WEEKDAYS=1,2,3,4,5
TIMEZONE=Asia/Yerevan

# Карточку получает каждая компания; ИИ помечает тех, у кого уже есть своё веб-приложение.
# Дополнительные фильтры, 0 = выключено: последний пост в Instagram не старше ACTIVE_DAYS дней,
# постов не больше MAX_POSTS, отзывов в Google не больше MAX_REVIEWS
ACTIVE_DAYS=0
MAX_POSTS=0
MAX_REVIEWS=0
# Минимальная оценка ИИ (1–10), 0 = присылать всех
MIN_SCORE=0
